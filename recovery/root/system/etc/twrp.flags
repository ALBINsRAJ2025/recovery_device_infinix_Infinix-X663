# mount point       fstype    device                             flags
/boot               emmc      /dev/block/by-name/boot           flags=display="Boot";backup=1;flashimg=1;slotselect
/vendor_boot        emmc      /dev/block/by-name/vendor_boot    flags=display="Vendor_boot";flashimg=1;slotselect
/dtbo               emmc      /dev/block/by-name/dtbo           flags=display="Dtbo";flashimg=1;slotselect
/vbmeta             emmc      /dev/block/by-name/vbmeta         flags=display="Vbmeta";flashimg=1;slotselect
/vbmeta_system      emmc      /dev/block/by-name/vbmeta_system  flags=display="Vbmeta_system";flashimg=1;slotselect
/vbmeta_vendor      emmc      /dev/block/by-name/vbmeta_vendor  flags=display="Vbmeta_vendor";flashimg=1;slotselect
/super              emmc      /dev/block/by-name/super          flags=display="Super";flashimg=1

/bootloader         emmc      /dev/block/by-name/lk             flags=display="Bootloader";backup=1;flashimg=1
/bootloader2        emmc      /dev/block/by-name/lk2            flags=display="Bootloader2";flashimg=1
/boot_para          emmc      /dev/block/by-name/boot_para      flags=display="Boot_para"
/gz1                emmc      /dev/block/by-name/gz1            flags=display="Gz 1";flashimg=1
/gz2                emmc      /dev/block/by-name/gz2            flags=display="Gz 2";flashimg=1
/logo               emmc      /dev/block/by-name/logo           flags=display="Logo";flashimg=1
/md1img             emmc      /dev/block/by-name/md1img         flags=display="Md1img";flashimg=1
/md1dsp             emmc      /dev/block/by-name/md1dsp         flags=display="Md1dsp"
/para               emmc      /dev/block/by-name/para           flags=display="Para"
/persist            emmc      /dev/block/by-name/persist        flags=display="Persist";backup=1
/persistent         emmc      /dev/block/by-name/frp            flags=display="Persistent";backup=1
/scp1               emmc      /dev/block/by-name/scp1           flags=display="Scp 1";flashimg=1
/scp2               emmc      /dev/block/by-name/scp2           flags=display="Scp 2";flashimg=1
/sec1               emmc      /dev/block/by-name/sec1           flags=display="Sec1"
/spmfw              emmc      /dev/block/by-name/spmfw          flags=display="Spmfw";flashimg=1
/sspm_1             emmc      /dev/block/by-name/sspm_1         flags=display="Sspm 1";flashimg=1
/sspm_2             emmc      /dev/block/by-name/sspm_2         flags=display="Sspm 2";flashimg=1
/tee1               emmc      /dev/block/by-name/tee1           flags=display="Tee 1";flashimg=1
/tee2               emmc      /dev/block/by-name/tee2           flags=display="Tee 2";flashimg=1
/expdb              emmc      /dev/block/by-name/expdb          flags=display="Expdb"
/otp                emmc      /dev/block/by-name/otp            flags=display="Otp"
/seccfg             emmc      /dev/block/by-name/seccfg         flags=display="Seccfg"
/tranfs             ext4      /dev/block/by-name/tranfs         flags=display="Tranfs"
/metadata           ext4      /dev/block/by-name/md_udc         flags=storage;display="Metadata"

# IMEI and modem related
# below four partitions are ext4, but we are using only for backup so emmc
/protect_f          emmc      /dev/block/by-name/protect1       flags=display="Protect_f";backup=1
/protect_s          emmc      /dev/block/by-name/protect2       flags=display="Protect_s";backup=1
/nvdata             emmc      /dev/block/by-name/nvdata         flags=display="Nvdata";backup=1
/nvcfg              emmc      /dev/block/by-name/nvcfg          flags=display="Nvcfg";backup=1
/nvram              emmc      /dev/block/by-name/nvram          flags=display="Nvram";backup=1
/proinfo            emmc      /dev/block/by-name/proinfo        flags=display="Proinfo";backup=1

# Removable
/external_sd        auto      /dev/block/mmcblk1p1      /dev/block/mmcblk1                  flags=storage;wipeingui;removable
/usb_otg            auto      /dev/block/sda1           /dev/block/sdd                      flags=storage;wipeingui;removable;display="USB OTG"

# Dynamic logical partitions inside super
/system_image       ext4      /dev/block/mapper/system          flags=display="System";backup=1;flashimg=1;slotselect
/vendor_image       ext4      /dev/block/mapper/vendor          flags=display="Vendor";backup=1;flashimg=1;slotselect
/system_ext_image   ext4      /dev/block/mapper/system_ext      flags=display="System_ext";backup=1;flashimg=1;slotselect
/product_image      ext4      /dev/block/mapper/product         flags=display="Product";backup=1;flashimg=1;slotselect
